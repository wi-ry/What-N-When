{
  "name": "notion-calendar-widget",
  "version": "2.0.6",
  "description": "Notion Calendar desktop widget",
  "author": "Will Ryan <will@willryan.ca>",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "check": "node --check web/renderer.js && node --check web/optionsRenderer.js",
