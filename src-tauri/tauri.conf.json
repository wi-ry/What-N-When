{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notion Calendar Widget",
  "version": "2.0.0",
  "identifier": "ca.willryan.notioncalendarwidget",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Notion Calendar",
        "width": 800,
        "height": 600,
        "decorations": false,
        "resizable": true,
        "minWidth": 300,
        "minHeight": 200,
        "skipTaskbar": true,
        "shadow": true,
        "backgroundColor": "#1a1a1a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../web/assets/notion-calendar.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
